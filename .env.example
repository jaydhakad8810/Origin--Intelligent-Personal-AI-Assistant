# PostgreSQL connection string for the Origin database
DATABASE_URL=

# Google OAuth client ID, used for Google sign-in
GOOGLE_CLIENT_ID=

# Google OAuth client secret, used for Google sign-in
GOOGLE_CLIENT_SECRET=

# Secret used to sign user login sessions
SESSION_SECRET=

# Key used to encrypt stored Google tokens in the database
TOKEN_ENCRYPTION_KEY=

# API key for calling Claude (the LLM)
ANTHROPIC_API_KEY=

# Base URL of the Origin API, used by the web app (default: http://localhost:8000)
NEXT_PUBLIC_API_URL=

# Web app address, used for CORS and redirects after sign-in (default: http://localhost:3000)
WEB_ORIGIN=

# Public address of this API, used as the Google sign-in redirect base (default: http://localhost:8000)
API_BASE_URL=

# Set to true to send the login cookie over HTTPS only (default: false)
COOKIE_SECURE=

# Which AI provider answers chat: demo (default, no key needed). Gemini comes later.
LLM_PROVIDER=

# Max chat messages per user per UTC day (default: 50)
LLM_DAILY_LIMIT=

# API key for Gemini (not used yet)
GEMINI_API_KEY=

# Gemini model name (not used yet)
GEMINI_MODEL=
