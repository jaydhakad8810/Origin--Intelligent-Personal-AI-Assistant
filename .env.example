# PostgreSQL connection string for the Origin database
DATABASE_URL=

# Google OAuth client ID, used for Google sign-in
GOOGLE_CLIENT_ID=

# Google OAuth client secret, used for Google sign-in
GOOGLE_CLIENT_SECRET=

# Secret used to sign user login sessions
SESSION_SECRET=

# Key used to encrypt stored Google tokens in the database
TOKEN_ENCRYPTION_KEY=

# API key for calling Claude (the LLM)
ANTHROPIC_API_KEY=

# Base URL of the Origin API, used by the web app (default: http://localhost:8000)
NEXT_PUBLIC_API_URL=
